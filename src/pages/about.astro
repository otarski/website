---
/**
 * About page
 * URL: /about
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import TechStack from '@/components/landing/TechStack.astro';
---

<PageLayout
  title="About Otarski — AI systems & digital platforms"
  description="Otarski is a software engineering company specializing in production-grade AI systems, intelligent automation, and fullstack digital platforms for organizations worldwide."
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="building-2" size="sm" />
      Company
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Engineering</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">for the real world</span>
    </h1>

    <p slot="description">
      We partner with startups, mid-sized enterprises, and global teams to ship software that performs under pressure — from intelligent applications and automation to end-to-end product engineering.
    </p>
  </Hero>

  <section class="py-[var(--space-section-md)] bg-brand-500/8 dark:bg-background-secondary">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-12 lg:grid-cols-2">
        <div class="flex flex-col gap-4" data-reveal>
          <div class="flex flex-col gap-6">
            <Badge variant="brand" pill class="self-start">Who we are</Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              Software you can run,<br />
              <span class="text-brand-500">operate, and evolve.</span>
            </h2>
          </div>
          <p class="text-lg text-foreground-muted leading-relaxed">
            Otarski focuses on systems that are functional, robust, and maintainable — aligned with operational reality, not slide-deck architecture. Our approach combines deep technical expertise with disciplined execution so your organization can accelerate innovation without sacrificing reliability.
          </p>
          <p class="text-lg text-foreground-muted leading-relaxed">
            We work across AI-driven application development, intelligent automation, and fullstack engineering — with an emphasis on rapid prototyping when you need to learn quickly, and production-ready delivery when you are ready to scale.
          </p>
        </div>
        <div class="flex flex-col gap-4 h-full" data-reveal data-reveal-delay="1">
          <Card variant="elevated" hover class="flex-1 flex flex-col justify-center">
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="globe" size="md" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-bold tracking-wide text-foreground-muted mb-1">Reach</p>
                <h3 class="text-base font-semibold text-foreground">Global engagements</h3>
                <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                  Remote-first delivery with clear communication rhythms and documentation — so distributed teams stay aligned from kickoff through handover.
                </p>
              </div>
            </div>
          </Card>
          <Card variant="elevated" hover class="flex-1 flex flex-col justify-center">
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="users" size="md" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-bold tracking-wide text-foreground-muted mb-1">Clients</p>
                <h3 class="text-base font-semibold text-foreground">Who we serve</h3>
                <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                  Startups validating new products, SMEs modernizing critical workflows, and global organizations that need consistent, high-quality engineering with measurable business value.
                </p>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <section class="py-[var(--space-section-md)] border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-8 text-center flex flex-col items-center gap-4" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Operating principles</Badge>
          <h2 class="font-display text-4xl font-bold text-foreground">
            What you can expect
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          Clarity, speed, and precision in every engagement — so work moves efficiently from concept to deployment.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-3" data-reveal data-reveal-delay="1">
        <Card hover>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="crosshair" size="md" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Outcome-led</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                We anchor engineering decisions in goals, constraints, and success metrics — so effort maps to business impact, not activity for its own sake.
              </p>
            </div>
          </div>
        </Card>
        <Card hover>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="shield-check" size="md" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Production discipline</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Reliability, observability, and maintainability are part of the definition of done — not a late-stage add-on.
              </p>
            </div>
          </div>
        </Card>
        <Card hover>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="gauge" size="md" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Speed with clarity</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Rapid prototyping when you need to learn fast; hardened releases when you need to scale — with transparent trade-offs at each step.
              </p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <TechStack
    badge="Stack"
    title="Technologies we use"
    description="Modern languages, runtimes, and cloud-native patterns — chosen for performance, security, and long-term maintainability."
  />

  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>FAQ</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Common questions
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          A short list of what partners ask before we start.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <Card variant="elevated" padding="lg" data-reveal data-reveal-delay="1">
          <div class="flex items-center gap-3 pb-4 border-b border-border">
            <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="sparkles" size="md" />
            </div>
            <h3 class="font-display text-base font-semibold text-foreground">About Otarski</h3>
          </div>
          <div class="w-full">
            <details class="border-b border-border" name="faq-co">
              <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                What kinds of projects do you take on?
                <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
              </summary>
              <div class="pb-4 text-sm text-foreground-muted leading-relaxed">
                AI-driven applications, intelligent automation, and fullstack product engineering — from greenfield builds to hardening and extending existing systems. If the problem needs serious engineering and clear ownership, we are interested.
              </div>
            </details>
            <details class="border-b border-border" name="faq-co">
              <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                Do you work with teams outside your time zone?
                <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
              </summary>
              <div class="pb-4 text-sm text-foreground-muted leading-relaxed">
                Yes. We engage with organizations globally and run remote-first projects with structured communication, written decisions, and overlap windows that match your team.
              </div>
            </details>
            <details class="border-b border-border last:border-0" name="faq-co">
              <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                How do engagements usually start?
                <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
              </summary>
              <div class="pb-4 text-sm text-foreground-muted leading-relaxed">
                Most work begins with a short discovery phase: goals, constraints, risks, and a delivery plan. From there we align on milestones, interfaces with your team, and what “done” means in production.
              </div>
            </details>
          </div>
        </Card>

        <Card variant="elevated" padding="lg" data-reveal data-reveal-delay="2">
          <div class="flex items-center gap-3 pb-4 border-b border-border">
            <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="briefcase" size="md" />
            </div>
            <h3 class="font-display text-base font-semibold text-foreground">Delivery &amp; collaboration</h3>
          </div>
          <div class="w-full">
            <details class="border-b border-border" name="faq-del">
              <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                Can you work inside our existing codebase?
                <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
              </summary>
              <div class="pb-4 text-sm text-foreground-muted leading-relaxed">
                Yes. We routinely integrate with client repositories, CI/CD, and security requirements — whether that means extending services, introducing automation, or partnering with your internal platform team.
              </div>
            </details>
            <details class="border-b border-border" name="faq-del">
              <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                What happens after launch?
                <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
              </summary>
              <div class="pb-4 text-sm text-foreground-muted leading-relaxed">
                We plan for handover: documentation, observability, and operational runbooks as needed. Many clients retain us for iteration, performance work, or on-call support — scoped to what you actually need.
              </div>
            </details>
            <details class="border-b border-border last:border-0" name="faq-del">
              <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                How quickly can you start?
                <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
              </summary>
              <div class="pb-4 text-sm text-foreground-muted leading-relaxed">
                Lead time depends on scope and team availability. After an initial conversation we typically propose a small discovery milestone so you can evaluate fit before committing to a larger build.
              </div>
            </details>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-2xl px-6 text-center" data-reveal>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        Next step
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        Tell us what you are building and what “success” looks like in production. We will follow up with concrete questions and a suggested path forward.
      </p>
      <Button size="lg" href="/contact">
        Contact Otarski
        <Icon name="arrow-right" size="sm" />
      </Button>
    </div>
  </section>
</PageLayout>

<style>
  details[open] > summary .faq-icon {
    transform: rotate(180deg);
  }
</style>

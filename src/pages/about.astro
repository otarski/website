---
/**
 * About page
 * URL: /about
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
---

<PageLayout
  title="About Otarski — Hiring AI assurance"
  description="Otarski provides independent analysis and review for organizations that use automated tools in hiring and recruiting."
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="scale" size="sm" />
      Company
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Independent assurance</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">for hiring AI</span>
    </h1>

    <p slot="description">
      We help HR and legal teams get a disciplined outside view of fairness and risk in AI-assisted recruiting — so you can make decisions with clearer information, not louder marketing claims.
    </p>
  </Hero>

  <section class="py-[var(--space-section-md)] bg-brand-500/8 dark:bg-background-secondary">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-12 lg:grid-cols-2">
        <div class="flex flex-col gap-4" data-reveal>
          <div class="flex flex-col gap-6">
            <Badge variant="brand" pill class="self-start">Who we are</Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              A focused team<br />
              <span class="text-brand-500">on one class of problem.</span>
            </h2>
          </div>
          <p class="text-base sm:text-lg text-foreground-muted leading-relaxed">
            Otarski works on fairness and oversight questions that show up when screening, ranking, or scoring is automated. We are not a general-purpose AI consultancy and not a recruiting software vendor — we concentrate on measurement, monitoring, and independent review in that lane.
          </p>
          <p class="text-base sm:text-lg text-foreground-muted leading-relaxed">
            Offerings are organized around three entry points — <strong class="text-foreground">Diagnosis</strong>, <strong class="text-foreground">Monitoring</strong>, and <strong class="text-foreground">Audit</strong> — so you can match depth of work to the question you are trying to answer.
          </p>
        </div>
        <div class="flex flex-col gap-4 h-full" data-reveal data-reveal-delay="1">
          <Card variant="elevated" hover class="flex-1 flex flex-col justify-center">
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="users" size="md" />
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-base font-semibold text-foreground">Who we work with</h3>
                <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                  People teams, in-house counsel, and operations leaders who need credible analysis when hiring volume, tooling, or external scrutiny increases.
                </p>
              </div>
            </div>
          </Card>
          <Card variant="elevated" hover class="flex-1 flex flex-col justify-center">
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="globe" size="md" />
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-base font-semibold text-foreground">Jurisdictions</h3>
                <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                  Deliverables are tailored to the locations and regulatory context you identify. Your counsel remains responsible for how requirements apply to your organization.
                </p>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <section class="py-[var(--space-section-md)] border-t border-border">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-8 text-center flex flex-col items-center gap-4" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Principles</Badge>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-foreground">What you can expect</h2>
        </div>
        <p class="text-base sm:text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          We aim to be precise about what the evidence supports, transparent about limits, and clear about what we will not do when it would compromise independence.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-3" data-reveal data-reveal-delay="1">
        <Card hover>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="shield-check" size="md" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Independence</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                We do not sell the hiring models we review. Formal audit-style work is structured so conclusions are not only machine-generated.
              </p>
            </div>
          </div>
        </Card>
        <Card hover>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="database" size="md" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Data restraint</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                We retain only what an engagement requires, explain what we hold and why, and prefer aggregate and statistical outputs where that is appropriate to the question.
              </p>
            </div>
          </div>
        </Card>
        <Card hover>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="file-text" size="md" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Clear reporting</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Written outputs describe methods and assumptions in plain language so stakeholders outside data science can follow the thread.
              </p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>FAQ</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">Common questions</h2>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <Card variant="elevated" padding="lg" data-reveal data-reveal-delay="1">
          <div class="flex items-center gap-3 pb-4 border-b border-border">
            <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="sparkles" size="md" />
            </div>
            <h3 class="font-display text-base font-semibold text-foreground">Fit</h3>
          </div>
          <div class="w-full">
            <details class="border-b border-border" name="faq-co">
              <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                Is Otarski a hiring software vendor?
                <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
              </summary>
              <div class="pb-4 text-sm text-foreground-muted leading-relaxed">
                No. We focus on review and analysis rather than selling applicant tracking or scoring products.
              </div>
            </details>
            <details class="border-b border-border last:border-0" name="faq-co">
              <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                Do we have to use every service?
                <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
              </summary>
              <div class="pb-4 text-sm text-foreground-muted leading-relaxed">
                No. We recommend an entry point after we understand your goals. Some teams need a single study; others want ongoing oversight or a formal review.
              </div>
            </details>
          </div>
        </Card>

        <Card variant="elevated" padding="lg" data-reveal data-reveal-delay="2">
          <div class="flex items-center gap-3 pb-4 border-b border-border">
            <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="briefcase" size="md" />
            </div>
            <h3 class="font-display text-base font-semibold text-foreground">Working together</h3>
          </div>
          <div class="w-full">
            <details class="border-b border-border" name="faq-del">
              <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                What should we send first?
                <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
              </summary>
              <div class="pb-4 text-sm text-foreground-muted leading-relaxed">
                A short note on your hiring workflow, tools in scope, and what decision you are trying to inform is enough to start. We will ask for data in a structured way if there is a match.
              </div>
            </details>
            <details class="border-b border-border last:border-0" name="faq-del">
              <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                How do we get started?
                <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
              </summary>
              <div class="pb-4 text-sm text-foreground-muted leading-relaxed">
                Use the contact form or email. We typically reply within a few business days with questions or to suggest a short intro call.
              </div>
            </details>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 text-center" data-reveal>
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-foreground mb-4 text-balance">Next step</h2>
      <p class="text-base sm:text-lg text-foreground-muted mb-8 text-balance">
        If this sounds aligned with what you need, reach out — we are straightforward about fit and timing.
      </p>
      <Button size="lg" href="/contact">
        Contact Otarski
        <Icon name="arrow-right" size="sm" />
      </Button>
    </div>
  </section>
</PageLayout>

<style>
  details[open] > summary .faq-icon {
    transform: rotate(180deg);
  }
</style>

---
/**
 * Product — single Otarski overview (URL: /projects)
 */
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import { getCollection, render } from 'astro:content';

const items = await getCollection('projects', ({ data }) => !data.draft);
const project = items[0];

if (!project) {
  throw new Error('No published product entry found in projects collection.');
}

const { Content } = await render(project);
---

<ProjectLayout
  title={project.data.title}
  description={project.data.description}
  year={project.data.year}
  client={project.data.client}
  role={project.data.role}
  services={project.data.services}
  repo={project.data.repo}
  tags={project.data.tags}
  image={project.data.image}
  imageAlt={project.data.imageAlt}
  related={[]}
  backLink={{ label: 'Back to home', href: '/' }}
>
  <Content />
</ProjectLayout>

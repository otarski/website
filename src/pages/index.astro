---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import { getCollection } from 'astro:content';
import siteConfig from '@/config/site.config';

const projectItems = await getCollection('projects');
const featuredProjects = projectItems
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
  })
  .slice(0, 3);
---

<LandingLayout
  title="Otarski — AI systems & digital platforms"
  description="Software engineering company specializing in production-grade AI systems, intelligent automation, and fullstack digital platforms for organizations worldwide."
  image="/og-default.svg"
  includeOrgSchema={true}
>
  <!-- Hero -->
  <Hero layout="centered" size="xl" class="hero-dark-gradient" showScrollIndicator descriptionClass="max-w-3xl">
    <Badge slot="badge" variant="brand" pill pulse class="dark:text-brand-200">Software engineering company</Badge>

    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Production-grade</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)] dark:text-foreground dark:[-webkit-text-fill-color:currentColor]">AI systems</span><span class="text-foreground [-webkit-text-fill-color:currentColor]"> &amp; digital platforms</span>
    </h1>

    <p slot="description">
      We design, build, and deploy intelligent software for startups, mid-sized enterprises, and global teams — from rapid prototypes to systems engineered for scale, reliability, and measurable business value.
    </p>

   <Fragment slot="actions">
      <Button size="lg" href="/contact">
        Start a conversation
        <Icon name="arrow-right" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href="/projects">
        <Icon name="layers" size="sm" />
        Our work
        <Icon name="arrow-right" size="sm" />
      </Button>
    </Fragment>
  </Hero>

  <!-- Services Section -->
  <section id="services" class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>What we deliver</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Engineering for real-world impact
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          AI-driven products, automation, and fullstack platforms — scoped for your stage, built for production.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal data-reveal-delay="1">
        <Card hover>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="cpu" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">AI systems &amp; intelligent apps</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Design and deployment of production-grade AI capabilities integrated into your products — reliable inference, data pipelines, and human-in-the-loop workflows where they matter.
              </p>
            </div>
          </div>
        </Card>

        <Card hover>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="network" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Intelligent automation</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Automate high-friction processes with observability and guardrails — so teams gain speed without sacrificing control or auditability.
              </p>
            </div>
          </div>
        </Card>

        <Card hover>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="layers" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">End-to-end product engineering</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Fullstack delivery from APIs and services to client experiences — rapid prototyping when you are learning, hardened releases when you are scaling.
              </p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

 <!-- About Teaser -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-12 lg:grid-cols-2">
        <div class="flex flex-col justify-center" data-reveal>
          <div class="flex flex-col gap-6 mb-6">
            <Badge variant="brand" pill class="self-start">About Otarski</Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              Deep expertise,<br />
              <span class="text-brand-500">disciplined execution.</span>
            </h2>
          </div>
          <p class="text-lg text-foreground-muted leading-relaxed mb-4">
            We combine strong engineering fundamentals with a bias for shipping — so your organization can move from concept to production without sacrificing reliability, security, or maintainability.
          </p>
          <p class="text-lg text-foreground-muted leading-relaxed mb-8">
            {siteConfig.address?.city
              ? `${siteConfig.address.city} · ${siteConfig.address.country || 'Global clients'}`
              : 'We work with teams around the world — from rapid prototypes to long-running platforms.'}
          </p>
           <Button variant="outline" href="/about" class="self-start">
            About the company
          </Button>
        </div>
        <Card variant="elevated" padding="lg" class="h-full flex flex-col" data-reveal data-reveal-delay="1">
          <p class="text-sm text-foreground mb-5 text-center">How we engage</p>
          <div class="grid grid-cols-2 gap-3 flex-1 auto-rows-fr">
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="crosshair" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Outcome-led delivery</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="shield-check" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Production discipline</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="globe" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Global partnerships</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="gauge" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Speed with clarity</p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Portfolio -->
  <section id="work" class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Selected work</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Capabilities &amp; case studies
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          Representative engagements and how we approach delivery.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2" data-reveal data-reveal-delay="1">
        {featuredProjects.map((project) => (
          <Card variant="elevated" hover padding="lg" href={`/projects/${project.id.replace(/\.mdx?$/, '')}`} class="group flex flex-col">
            <div class="flex flex-1 flex-col">
              <div class="mb-3 flex items-start justify-between gap-4">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                  <Icon name="layers" size="sm" />
                </div>
                <Icon name="arrow-up-right" size="sm" class="text-foreground-muted group-hover:text-brand-500 transition-colors shrink-0" />
              </div>
              <div class="mb-2 flex items-baseline gap-2">
                <h3 class="font-display text-lg font-bold text-foreground">{project.data.title}</h3>
                {project.data.year && (
                  <span class="text-xs text-foreground-muted">{project.data.year}</span>
                )}
              </div>
              <p class="text-sm text-foreground-muted leading-relaxed mb-4 flex-1">{project.data.description}</p>
              <div class="flex flex-wrap gap-1.5">
                {project.data.tags.map((tag) => (
                  <Badge variant="brand">{tag}</Badge>
                ))}
              </div>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Engagement principles -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Principles</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            How we work with your team
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          Every engagement is shaped around clarity, speed, and precision — so solutions move efficiently from concept to deployment and stay maintainable in production.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2" data-reveal data-reveal-delay="1">
        <Card variant="elevated" padding="lg" hover>
          <blockquote class="text-foreground-muted leading-relaxed text-base">
            We build systems that are not only functional but also robust, maintainable, and aligned with real-world business needs — designed for immediate impact and long-term scalability.
          </blockquote>
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-500 mt-6">Engineering standard</p>
        </Card>

        <Card variant="elevated" padding="lg" hover>
          <blockquote class="text-foreground-muted leading-relaxed text-base">
            We partner with organizations globally to transform ideas into scalable, reliable, and high-performance software — helping you accelerate innovation and reduce time to market.
          </blockquote>
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-500 mt-6">Partnership model</p>
        </Card>
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex items-end justify-between" data-reveal>
        <div class="flex flex-col gap-6">
          <Badge variant="brand" pill class="self-start">From the blog</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Featured
          </h2>
        </div>
        <a href="/blog" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-brand-500 hover:text-brand-600 transition-colors shrink-0">
          View all posts
          <Icon name="arrow-right" size="sm" />
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-3" data-reveal data-reveal-delay="1">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id.replace('en/', '')}`}
            publishedAt={post.data.publishedAt}
            tags={post.data.tags}
            author={post.data.author}
            image={post.data.image}
            svgSlug={post.data.svgSlug}
          />
        ))}
      </div>

      <div class="text-center sm:hidden">
        <Button variant="outline" href="/blog">
          View all posts
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

 <!-- CTA -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background">
    <div class="mx-auto max-w-2xl px-6 text-center" data-reveal>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        Plan your next release with us
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        Share your roadmap, technical constraints, and timeline. We will respond with a clear path forward — typically a discovery conversation or a short written assessment.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href="/contact">
          Contact Otarski
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href="/about">
          About the company
        </Button>
      </div>
    </div>
  </section>

<script>
  function initCountup() {
    const counters = document.querySelectorAll<HTMLElement>('[data-countup]:not([data-countup-init])');
    if (counters.length === 0) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.countup ?? '0', 10);
        const suffix = el.dataset.suffix ?? '';
        const duration = 1200;
        const start = performance.now();
        const tick = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(eased * target) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });
    counters.forEach((el) => {
      el.dataset.countupInit = 'true';
      observer.observe(el);
    });
  }

  document.addEventListener('astro:page-load', initCountup);
</script>
</LandingLayout>

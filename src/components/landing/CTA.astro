---
import CTASection from '@/components/ui/marketing/CTA/CTA.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Logo from '@/components/ui/marketing/Logo/Logo.astro';
---

<CTASection id="cta" variant="default" size="xl" maxWidth="lg">
  <Logo slot="logo" size="2xl" class="mx-auto" />

  <h2 slot="heading">
    Ready to <span class="text-brand-500">ship?</span>
  </h2>

  <p slot="description">
    Tell us about your roadmap, constraints, and timeline. We will respond with a clear next step — usually a short discovery call or a written assessment.
  </p>

  <Fragment slot="actions">
    <Button size="lg" href="/contact">
      Talk to Otarski
      <Icon name="arrow-right" size="md" />
    </Button>
    <Button variant="outline" size="lg" href="/projects">
      <Icon name="layers" size="md" />
      View capabilities
    </Button>
  </Fragment>
</CTASection>
